DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://benchplan:benchplan@postgres:5432/benchplan
REDIS_URL=redis://redis:6379/0

# Fireworks AI Configuration (Kimi K2.5 Turbo)
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/routers/kimi-k2p5-turbo

# Literature Search APIs
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=
PROTOCOLS_IO_CLIENT_TOKEN=
NCBI_API_KEY=
NCBI_TOOL=benchplan-ai
NCBI_EMAIL=

# Application Settings
DEFAULT_CURRENCY=USD
VITE_API_BASE_URL=http://localhost:8000

# CORS / CSRF (local frontend dev)
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CORS_ALLOWED_ORIGIN_REGEXES=^http://localhost:\d+$,^http://127\.0\.0\.1:\d+$
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
